# Copy to .env and change values as needed.

# If you change this, also set API_PROXY_TARGET for the client (see client/vite.config.ts).
SERVER_PORT=3000

# The database the server, migrations, and seed script use.
# The default matches the database that `pnpm db:up` starts.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/where_to_play

# The database that integration tests use. Tests delete its data.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/where_to_play_test

# The server uses this for game search. The collection importer uses it too.
BGG_API_TOKEN=
# Only the E2E tests set this, to send BGG requests to a fake BGG. Leave it empty.
BGG_BASE_URL=

# Only BGG tag changes (`pnpm tags:sync`, or `pnpm import:collections` with no --skip-tags) use these.
# The BGG account that owns the collection tags.
BGG_USERNAME=
BGG_PASSWORD=
GOOGLE_SHEETS_API_KEY=
