# Copy to .env and change values as needed.

# If you change this, also change the /api proxy target in client/vite.config.ts.
SERVER_PORT=3000

# The database the server, migrations, and seed script use.
# The default matches the database that `pnpm db:up` starts.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/where_to_play

# The database that integration tests use. Tests delete its data.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/where_to_play_test
