{
  "name": "@where-to-play/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "import:collections": "tsx --env-file-if-exists=.env scripts/import-collections.ts",
    "collections:upsert": "tsx --env-file-if-exists=.env scripts/upsert-collections.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "entities": "^8.1.0",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.16",
    "postgres": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
