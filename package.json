{
  "name": "where-to-play",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "test:e2e": "pnpm --filter @where-to-play/e2e test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "db:reset": "docker compose down --volumes && pnpm db:setup",
    "db:generate": "pnpm --filter @where-to-play/server db:generate",
    "db:migrate": "pnpm --filter @where-to-play/server db:migrate",
    "db:seed": "pnpm --filter @where-to-play/server db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "typescript": "^7.0.2"
  }
}
